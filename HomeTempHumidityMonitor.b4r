Build1=Default,B4RDev
Group=Default Group
Library1=rcore
Library2=resp8266
Library3=resp8266wifi
Library4=rmqtt
Library5=rrandomaccessfile
Library6=resp8266timetools
NumberOfFiles=0
NumberOfLibraries=6
NumberOfModules=0
Version=3.9
@EndOfDesignText@
#Region Project Attributes
	#AutoFlushLogs: True
	#CheckArrayBounds: True
	#StackBufferSize: 3000
#End Region

Sub Process_Globals
	Public Serial1 As Serial

	Private d1pins As D1Pins
	Private d3pins As D1Pins

	Private pin16 As Pin
	Private d6 As Pin

	Private WiFi As ESP8266WiFi
	Private WiFiStr As WiFiSocket

	Private MQTT As MqttClient

	Private WiFiSSID As String = "RiseAboveThisHome"
	Private WiFiPassword As String = "<WIFI_PASSWORD>"

	Private MQTTPort As Int = 1883
	Private MQTTClientId As String = "LivingRoomTempHumid"

	Private WiFiRetryScheduled As Boolean = False
	Private MQTTRetryScheduled As Boolean = False
	Private MQTTInitialized As Boolean = False
	Private MQTTConnected As Boolean = False
	Private SensorLoopStarted As Boolean = False

	Private ESP As ESP8266

	Public DHT22pin As Pin

	Public DHT22Temp As Double
	Public DHT22Hum As Double
	Public DHT22State As Int
	Public DHT22Valid As Boolean

	Public DHT22HeatIndex As Double
	Public DHT22DewPoint As Double
	Public DHT22Perception As Int
	Public DHT22ComfortStatus As Int

	Public DHT22HumidityAddValue As Double

	Private bc As ByteConverter

	Public timelib As ESPTimetools

	Private TimeClientInitialized As Boolean = False
	Private ClockValid As Boolean = False

	Private ClockBaseTimestamp As ULong
	Private ClockBaseMillis As ULong

	Private NTPAttempted As Boolean = False
	Private LastNTPAttemptMillis As ULong
	Private LastNTPSuccessMillis As ULong
End Sub


Private Sub AppStart
	Serial1.Initialize(115200)

	Delay(3000)

	Log("AppStart")

	Dim bb() As Byte = "LivingRoomTempHumid"

	RunNative("SetHostName", bb)
	RunNative("stopAP", Null)

	pin16.Initialize(16, pin16.MODE_OUTPUT)
	d6.Initialize(d1pins.D6, d6.MODE_OUTPUT)

	pin16.DigitalWrite(True)

	DHT22pin.Initialize(d3pins.D3, DHT22pin.MODE_INPUT)

	RunNative("PrepareConfiguredWiFi", Null)

	Delay(500)

	ConnectToWifi
End Sub


Sub ConnectToWifi

	If WiFi.IsConnected Then

		WiFiRetryScheduled = False

		RunNative("EnableWifiAutoReconnect", Null)

		Log("Connected to ", WiFiSSID, _
			" network, Local IP ", WiFi.LocalIp)

		InitializeMQTT

		MQTT_Connect(0)

		Return

	End If


	pin16.DigitalWrite(True)

	Log("Connecting to ", WiFiSSID)


	If WiFi.Connect2(WiFiSSID, WiFiPassword) Then

		WiFiRetryScheduled = False

		RunNative("EnableWifiAutoReconnect", Null)

		Log("Connected to ", WiFiSSID, _
			" network, Local IP ", WiFi.LocalIp)

		InitializeMQTT

		MQTT_Connect(0)

	Else

		Log("WiFi connection failed")

		If WiFiRetryScheduled = False Then

			WiFiRetryScheduled = True

			CallSubPlus("WiFi_Retry", 5000, 0)

		End If

	End If

End Sub


Sub WiFi_Retry(Unused As Byte)

	WiFiRetryScheduled = False

	ConnectToWifi

End Sub


Private Sub InitializeMQTT

	If MQTTInitialized Then Return

	MQTT.Initialize( _
		WiFiStr.stream, _
		Array As Byte(192, 168, 1, 125), _
		MQTTPort, _
		MQTTClientId, _
		"MQTT_MessageArrived", _
		"MQTT_Disconnected")

	MQTTInitialized = True

End Sub


Sub MQTT_Connect(Unused As Byte)

	MQTTRetryScheduled = False


	If WiFi.IsConnected = False Then

		MQTTConnected = False

		ConnectToWifi

		Return

	End If


	If MQTTInitialized = False Then

		InitializeMQTT

	End If


	If MQTT.Connect = False Then

		MQTTConnected = False

		pin16.DigitalWrite(True)

		Log("Not connected to broker")

		If MQTTRetryScheduled = False Then

			MQTTRetryScheduled = True

			CallSubPlus("MQTT_Connect", 5000, 0)

		End If

	Else

		MQTTConnected = True

		pin16.DigitalWrite(False)

		Log("Connected to broker")

		MQTT.Subscribe("TempHumid", 0)
		MQTT.Subscribe("HumidityAddValue", 0)

		If SensorLoopStarted = False Then

			ReadSensor

		Else

			ReadWeather(1)

		End If

	End If

End Sub


Sub MQTT_MessageArrived (Topic As String, Payload() As Byte)

	Log("Message arrived. Topic=", Topic, _
		" Payload=", Payload)


	If Topic = "TempHumid" Then

		If Payload = "Restart controller" Then

			MQTT.Publish( _
				"TempHumid", _
				"*Restarting relay by remote")

			Delay(250)

			ESP.Restart

		Else If Payload = "Read weather" Then

			ReadWeather(1)

		End If


	Else If Topic = "HumidityAddValue" Then

		DHT22HumidityAddValue = _
			bc.StringFromBytes(Payload)

		If IsNumber(DHT22HumidityAddValue) = False Then

			DHT22HumidityAddValue = 0

		End If

	End If

End Sub


Sub MQTT_Disconnected

	MQTTConnected = False

	pin16.DigitalWrite(True)

	Log("Disconnected from broker")

	MQTT.Close

	If MQTTRetryScheduled = False Then

		MQTTRetryScheduled = True

		CallSubPlus("MQTT_Connect", 5000, 0)

	End If

End Sub


' ============================================================
' TIME
'
' Sensor publishing never waits for NTP.
'
' First valid reading after boot:
'   1. Publish immediately.
'   2. If no synchronized clock exists, use:
'      1970-01-01 | 00:00:00
'   3. AFTER publishing, attempt NTP synchronization.
'
' After NTP succeeds:
'   Local time advances from the saved NTP timestamp using
'   Millis.
'
' Resync:
'   Every 6 hours.
'
' NTP failure:
'   Keep publishing.
'   Preserve an already-valid local clock.
'   Retry no more often than every 5 minutes.
' ============================================================

Private Sub StartTimeSystem

	If TimeClientInitialized = False Then

		timelib.initialize("pool.ntp.org", 0)

		TimeClientInitialized = True

		Log("NTP client initialized")

	End If

End Sub


Private Sub TimeSync

	If WiFi.IsConnected = False Then

		Return

	End If


	NTPAttempted = True

	LastNTPAttemptMillis = Millis


	If TimeClientInitialized = False Then

		StartTimeSystem

	End If


	Dim NewTimestamp As ULong

	NewTimestamp = timelib.timestamp


	If NewTimestamp <> 0 Then

		ClockBaseTimestamp = NewTimestamp

		ClockBaseMillis = Millis

		LastNTPSuccessMillis = ClockBaseMillis

		ClockValid = True

		Log("NTP sync OK. Timestamp=", NewTimestamp)

	Else

		If ClockValid Then

			Log("NTP sync failed - keeping synchronized local clock")

		Else

			Log("NTP sync failed - sensor publishing remains active")

		End If

	End If

End Sub


Private Sub GetCurrentTimestamp As ULong

	If ClockValid = False Then

		Return 0

	End If


	Dim ElapsedMs As ULong

	ElapsedMs = Millis - ClockBaseMillis


	Dim ElapsedSeconds As ULong

	ElapsedSeconds = ElapsedMs / 1000


	Return ClockBaseTimestamp + ElapsedSeconds

End Sub


Private Sub NTPRefreshIfNeeded

	Dim CurrentMillis As ULong

	CurrentMillis = Millis


	If ClockValid = False Then

		If NTPAttempted = False Then

			TimeSync

			Return

		End If


		Dim SinceAttempt As ULong

		SinceAttempt = CurrentMillis - LastNTPAttemptMillis


		If SinceAttempt >= 300000 Then

			TimeSync

		End If


	Else

		Dim SinceSuccess As ULong

		SinceSuccess = CurrentMillis - LastNTPSuccessMillis


		If SinceSuccess >= 21600000 Then

			Dim SinceAttempt As ULong

			SinceAttempt = CurrentMillis - LastNTPAttemptMillis


			If SinceAttempt >= 300000 Then

				TimeSync

			End If

		End If

	End If

End Sub


Public Sub ReadSensor

	Log("Initializing DHT22")

	RunNative("setup", Null)

	' DHT22 requires about 2 seconds after initialization.
	Delay(2500)

	If SensorLoopStarted = False Then

		SensorLoopStarted = True

		Log("Starting 60-second DHT22 loop")

		ReadWeather(0)

	End If

End Sub


Sub ReadWeather(tag As Byte)

	RunNative("ReadDHT22", Null)


	Dim localstate As String


	Select Case DHT22State

		Case 0

			localstate = "OK"

		Case 1

			localstate = "TIMEOUT"

		Case 2

			localstate = "CHECKSUM"

		Case 3

			localstate = "INVALID"

		Case Else

			localstate = "UNKNOWN"

	End Select


	Log( _
		"DHT22 read: State=", localstate, _
		" Valid=", DHT22Valid, _
		" Temp=", DHT22Temp, _
		" Hum=", DHT22Hum)


	If WiFi.IsConnected And MQTTConnected Then

		If DHT22Valid Then


			Dim CurrentTimestamp As ULong

			CurrentTimestamp = GetCurrentTimestamp


			Dim DatePart As String
			Dim TimePart As String


			If CurrentTimestamp <> 0 Then

				DatePart = JoinStrings(Array As String( _
					NumberFormat(timelib.getyear(CurrentTimestamp),2,0), "-", _
					NumberFormat(timelib.getmonth(CurrentTimestamp),2,0), "-", _
					NumberFormat(timelib.getday(CurrentTimestamp),2,0)))


				TimePart = JoinStrings(Array As String( _
					NumberFormat(timelib.gethour(CurrentTimestamp),2,0), ":", _
					NumberFormat(timelib.getminute(CurrentTimestamp),2,0), ":", _
					NumberFormat(timelib.getseconds(CurrentTimestamp),2,0)))

			Else

				DatePart = "1970-01-01"

				TimePart = "00:00:00"

				Log("Clock not synchronized - publishing sensor data anyway")

			End If


			Dim s As String


			s = JoinStrings(Array As String( _
				localstate, "|", _
				DHT22Temp, "|", _
				DHT22Hum, "|", _
				DHT22Perception, "|", _
				DHT22ComfortStatus, "|", _
				DHT22HeatIndex, "|", _
				DHT22DewPoint, "|", _
				DatePart, "|", _
				TimePart))


			Log("TempHumid to MQTT: ", s)

			MQTT.Publish("TempHumid", s)


			' NTP happens only AFTER the valid sensor data
			' has already been published.
			NTPRefreshIfNeeded


		Else

			Log("DHT22 invalid - MQTT publish skipped")

		End If

	End If


	If tag = 0 Then

		Log("Next DHT22 read in 60 seconds")

		CallSubPlus("ReadWeather", 60000, 0)

	End If

End Sub


#If C

#include "DHTesp.h"
#include <math.h>

#define DHT22Pin 0

ComfortState cf;
DHTesp dht22;


void setup(B4R::Object* o) {

	dht22.setup(
		DHT22Pin,
		DHTesp::DHT22
	);

}


void SetHostName(B4R::Object* o) {

	B4R::Array* b =
		(B4R::Array*)B4R::Object::toPointer(o);

	char* c = (char*)b->data;

	WiFi.hostname(c);

}


void stopAP(B4R::Object* u) {

	WiFi.softAPdisconnect(true);

}


void PrepareConfiguredWiFi(B4R::Object* u) {

	WiFi.persistent(false);

	WiFi.setAutoReconnect(false);

	WiFi.disconnect();

	delay(250);

	WiFi.mode(WIFI_STA);

}


void EnableWifiAutoReconnect(B4R::Object* u) {

	WiFi.setAutoReconnect(true);

}


void ReadDHT22(B4R::Object* o) {

	/*
	 * Use the same DHTesp read sequence that worked in the
	 * original firmware and is used by the DHTesp ESP8266 example:
	 *
	 *   getHumidity()
	 *   getTemperature()
	 *   getStatus()
	 *
	 * Do NOT use getTempAndHumidity() here.
	 */

	float rawHumidity =
		dht22.getHumidity();

	float rawTemperature =
		dht22.getTemperature();

	DHTesp::DHT_ERROR_t status =
		dht22.getStatus();


	b4r_main::_dht22state = status;


	if (
		status != DHTesp::ERROR_NONE ||
		isnan(rawHumidity) ||
		isnan(rawTemperature)
	) {

		b4r_main::_dht22valid = false;


		if (
			status == DHTesp::ERROR_NONE &&
			(
				isnan(rawHumidity) ||
				isnan(rawTemperature)
			)
		) {

			b4r_main::_dht22state = 3;

		}


		b4r_main::_dht22hum =
			rawHumidity;

		b4r_main::_dht22temp =
			dht22.toFahrenheit(
				rawTemperature
			);

		b4r_main::_dht22heatindex = NAN;
		b4r_main::_dht22dewpoint = NAN;

		return;

	}


	b4r_main::_dht22valid = true;


	float humidity =
		rawHumidity +
		b4r_main::_dht22humidityaddvalue;


	float temperature =
		dht22.toFahrenheit(
			rawTemperature
		);


	b4r_main::_dht22hum =
		humidity;

	b4r_main::_dht22temp =
		temperature;


	b4r_main::_dht22heatindex =
		dht22.computeHeatIndex(
			temperature,
			humidity,
			true
		);


	b4r_main::_dht22dewpoint =
		dht22.computeDewPoint(
			temperature,
			humidity,
			true
		);


	b4r_main::_dht22perception =
		dht22.computePerception(
			temperature,
			humidity,
			true
		);


	dht22.getComfortRatio(
		cf,
		temperature,
		humidity,
		true
	);


	switch(cf) {

		case Comfort_OK:

			b4r_main::_dht22comfortstatus = 0;

			break;


		case Comfort_TooHot:

			b4r_main::_dht22comfortstatus = 1;

			break;


		case Comfort_TooCold:

			b4r_main::_dht22comfortstatus = 2;

			break;


		case Comfort_TooDry:

			b4r_main::_dht22comfortstatus = 4;

			break;


		case Comfort_TooHumid:

			b4r_main::_dht22comfortstatus = 8;

			break;


		case Comfort_HotAndHumid:

			b4r_main::_dht22comfortstatus = 9;

			break;


		case Comfort_HotAndDry:

			b4r_main::_dht22comfortstatus = 5;

			break;


		case Comfort_ColdAndHumid:

			b4r_main::_dht22comfortstatus = 10;

			break;


		case Comfort_ColdAndDry:

			b4r_main::_dht22comfortstatus = 6;

			break;


		default:

			b4r_main::_dht22comfortstatus = -1;

			break;

	}

}

#End If